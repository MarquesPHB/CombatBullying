{
  "builds": [
    { "src": "api/attachments/*.js", "use": "@vercel/node" },
    { "src": "api/index.py", "use": "@vercel/python" },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    { "src": "/api/attachments/(upload|status|download)", "dest": "/api/attachments/$1.js" },
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
